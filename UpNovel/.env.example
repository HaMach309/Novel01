# Sao chép thành file .env (cùng thư mục UpNovel), điền 2 dòng bên dưới, lưu file.
# KHÔNG commit file .env lên git.

# Ví dụ (thay bằng tài khoản thật của bạn, không dùng ngoặc kép):
# WATTPAD_USERNAME=email@example.com
# WATTPAD_PASSWORD=matKhauCuaBan

WATTPAD_USERNAME=
WATTPAD_PASSWORD=

# Tuỳ chọn: đường dẫn tới file .md
# NOVEL_MD_PATH=C:\path\to\novel.md
